# Copy into the secret manager/environment of the production API. Do not commit the filled file.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.invalid
APP_KEY=base64:REPLACE_WITH_A_RANDOM_KEY

LOG_CHANNEL=stack
LOG_STACK=application,security,audit
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# The repository schema has no sessions table; use file sessions on one node.
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Fill all database, mail and origin values in the secret manager.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cyberlaw_search
DB_USERNAME=cyberlaw_app
DB_PASSWORD=REPLACE_IN_SECRET_MANAGER
MAIL_MAILER=smtp
FRONTEND_ORIGINS=https://example.invalid
